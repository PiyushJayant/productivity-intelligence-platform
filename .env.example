# Non-secret local and deployment configuration.
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
REGION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true
MODEL=gemini-2.5-flash
APP_MODE=full

ASSISTANT_SERVICE_NAME=productivity-intelligence
TOOLBOX_SERVICE_NAME=productivity-toolbox
MIGRATION_JOB_NAME=productivity-migrate
AR_REPO=productivity-platform

ALLOYDB_REGION=us-central1
ALLOYDB_CLUSTER=productivity-cluster
ALLOYDB_INSTANCE=productivity-instance
ALLOYDB_AVAILABILITY_TYPE=ZONAL
ALLOYDB_DATABASE=productivity_platform
ALLOYDB_USER=productivity_app
ANALYTICS_DB_USER=productivity_analytics
ALLOYDB_IP_TYPE=private

TOOLBOX_URL=http://127.0.0.1:5000
TOOLBOX_AUDIENCE=
BIGQUERY_CONNECTION_ID=productivity_alloydb

VPC_NETWORK=productivity-vpc
VPC_SUBNET=productivity-us-central1
VPC_SUBNET_RANGE=10.20.0.0/24
PSA_RANGE_NAME=productivity-private-services

ASSISTANT_SA_NAME=productivity-intelligence
TOOLBOX_SA_NAME=productivity-toolbox
MIGRATION_SA_NAME=productivity-migrate
ADMIN_DB_SECRET=productivity-db-admin-password
APP_DB_SECRET=productivity-db-app-password
ANALYTICS_DB_SECRET=productivity-db-analytics-password
BUDGET_AMOUNT=5000INR
CLOUD_RUN_MAX_INSTANCES=3
BUDGET_NAME="Productivity Intelligence Platform Budget"
