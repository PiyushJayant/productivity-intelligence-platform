# Copy this file to .env. The git-ignored .env is the single source of truth
# for all operator-controlled application, infrastructure, cost, and secret values.

# Project and AI runtime
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
REGION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true
MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-005
EMBEDDING_DIMENSIONS=768
APP_MODE=full
COST_PROFILE=demo
ENVIRONMENT=demo
RESOURCE_LABELS=application=productivity-intelligence,environment=demo,managed-by=repository
BIGQUERY_MCP_URL=https://bigquery.googleapis.com/mcp

# Identity and tenant ownership. AUTH_MODE=disabled is only for local/demo
# development and is rejected when ENVIRONMENT=production.
AUTH_MODE=identity_platform
IDENTITY_PLATFORM_PROJECT_ID=your-project-id
# Optional Identity Platform tenant resource ID. Leave empty for a single-tenant
# Identity Platform project.
IDENTITY_PLATFORM_TENANT_ID=
# These custom claims are set only by the trusted membership provisioning flow.
IDENTITY_TENANT_CLAIM=app_tenant_id
IDENTITY_ROLE_CLAIM=app_role
DEFAULT_TENANT_ID=11111111-1111-4111-8111-111111111111
# Used only when AUTH_MODE=disabled and for migration-safe legacy backfill.
DEMO_SUBJECT_ID=22222222-2222-4222-8222-222222222222
AUTH_CLOCK_SKEW_SECONDS=30
# Existing Identity Platform UID to provision as the first tenant owner.
BOOTSTRAP_IDP_SUBJECT=replace-with-identity-platform-uid
# Controlled registration is enforced only when a deployed beforeCreate hook URL
# is configured. Identity mutation remains Phase 5-only.
IDENTITY_CONTROLLED_REGISTRATION=true
IDENTITY_BEFORE_CREATE_URL=
IDENTITY_PASSWORD_MIN_LENGTH=12
IDENTITY_PASSWORD_MAX_LENGTH=128

# Cloud resource names
ASSISTANT_SERVICE_NAME=productivity-intelligence
TOOLBOX_SERVICE_NAME=productivity-toolbox
MIGRATION_JOB_NAME=productivity-migrate
LIFECYCLE_JOB_NAME=productivity-lifecycle
AR_REPO=productivity-platform

# Networking
VPC_NETWORK=productivity-vpc
VPC_SUBNET=productivity-us-central1
VPC_SUBNET_RANGE=10.20.0.0/24
PSA_RANGE_NAME=productivity-private-services

# AlloyDB
ALLOYDB_REGION=us-central1
ALLOYDB_CLUSTER=productivity-cluster
ALLOYDB_INSTANCE=productivity-instance
ALLOYDB_MACHINE_TYPE=c4a-highmem-1
ALLOYDB_AVAILABILITY_TYPE=ZONAL
ALLOYDB_ACTIVATION_POLICY=ALWAYS
ALLOYDB_ESTIMATED_HOURLY_USD=0.15568
ALLOW_ALLOYDB_RESIZE=false
ALLOYDB_DATABASE=productivity_platform
ADMIN_DB_USER=postgres
ALLOYDB_USER=productivity_app
ANALYTICS_DB_USER=productivity_analytics
ALLOYDB_IP_TYPE=private

# Local dependency endpoints; cloud URLs are resolved from deployed services.
TOOLBOX_URL=http://127.0.0.1:5000
TOOLBOX_AUDIENCE=http://127.0.0.1:5000
BIGQUERY_DATASET=productivity_analytics
BIGQUERY_CONNECTION_ID=productivity_alloydb
BIGQUERY_ANALYTICS_PROCEDURE=get_productivity_trends_v2
ANALYTICS_BACKEND=federated
BIGQUERY_NATIVE_TVF=productivity_trends_v3
ANALYTICS_RETRY_ATTEMPTS=3
ANALYTICS_RETRY_BASE_SECONDS=0.25
ANALYTICS_RETRY_MAX_SECONDS=2

# Service identities and Secret Manager resource names
ASSISTANT_SA_NAME=productivity-intelligence
TOOLBOX_SA_NAME=productivity-toolbox
MIGRATION_SA_NAME=productivity-migrate
LIFECYCLE_SA_NAME=productivity-lifecycle
SCHEDULER_SA_NAME=productivity-scheduler
LIFECYCLE_ROLE_ID=productivityAlloydbLifecycle
ADMIN_DB_SECRET=productivity-db-admin-password
APP_DB_SECRET=productivity-db-app-password
ANALYTICS_DB_SECRET=productivity-db-analytics-password
PSEUDONYMIZATION_SECRET=productivity-pseudonymization-key

# Secret values. Replace all placeholders with independent random values of at
# least 24 characters. These values stay only in the git-ignored .env and are
# synchronized to numerically pinned Secret Manager versions during provisioning.
ADMIN_DB_PASSWORD=change-me-admin-at-least-24-characters
APP_DB_PASSWORD=change-me-application-at-least-24-characters
ANALYTICS_DB_PASSWORD=change-me-analytics-at-least-24-characters
PSEUDONYMIZATION_KEY=change-me-pseudonymization-at-least-32-characters

# Privacy and semantic enrichment
PRIVACY_RETENTION_DAYS=90
TAXONOMY_VERSION=taxonomy_v1

# Optional enterprise controls. These are provisioned only by setup/phase5.sh.
ENABLE_ALLOYDB_READ_POOL=true
ALLOYDB_READ_POOL=productivity-read-pool
ALLOYDB_READ_POOL_NODE_COUNT=1
ALLOYDB_READ_POOL_MACHINE_TYPE=c4a-highmem-1
ANALYTICS_ALLOYDB_INSTANCE=productivity-read-pool
ENABLE_CMEK=false
KMS_KEYRING=productivity-platform
KMS_ALLOYDB_KEY=alloydb
KMS_BIGQUERY_KEY=bigquery
KMS_SECRET_KEY=secrets
KMS_ROTATION_PERIOD=7776000s
ENABLE_VPC_SC=false
ACCESS_POLICY_ID=
SERVICE_PERIMETER_NAME=productivity-platform
VPC_SC_MODE=dry-run
VPC_SC_ENFORCEMENT_ACK=NOT_ACKNOWLEDGED

# Native analytics / CDC (Phase 4). Disabled until measured migration triggers
# justify the additional continuously-running resources.
ENABLE_DATASTREAM=false
DATASTREAM_LOCATION=us-central1
DATASTREAM_STREAM=productivity-activity-cdc
DATASTREAM_SOURCE_PROFILE=productivity-alloydb
DATASTREAM_DESTINATION_PROFILE=productivity-bigquery
BIGQUERY_NATIVE_TABLE=activity_events_native

# Phase 5 is the only billable execution boundary. Keep both values disabled
# in source-controlled templates and normal local development.
ENABLE_BILLABLE_PHASE=false
BILLING_ACK=NOT_ACKNOWLEDGED

# Cloud Run scaling and resources
ASSISTANT_MIN_INSTANCES=0
ASSISTANT_MAX_INSTANCES=1
ASSISTANT_CPU=1
ASSISTANT_MEMORY=1Gi
ASSISTANT_CONCURRENCY=20
ASSISTANT_TIMEOUT=300
TOOLBOX_MIN_INSTANCES=0
TOOLBOX_MAX_INSTANCES=1
TOOLBOX_CPU=1
TOOLBOX_MEMORY=512Mi
TOOLBOX_CONCURRENCY=40
TOOLBOX_TIMEOUT=120
MIGRATION_CPU=1
MIGRATION_MEMORY=1Gi
MIGRATION_TIMEOUT=900
SEED_DEMO=false

# Gemini request budgets
ROUTER_MAX_OUTPUT_TOKENS=512
ROUTER_THINKING_BUDGET=0
SPECIALIST_MAX_OUTPUT_TOKENS=768
SPECIALIST_THINKING_BUDGET=0
ANALYTICS_MAX_OUTPUT_TOKENS=1024
ANALYTICS_THINKING_BUDGET=256
ANALYTICS_MAX_RANGE_DAYS=730
ANALYTICS_QUERY_TIMEOUT_SECONDS=30
ANALYTICS_MAX_BYTES_BILLED=1073741824
AGENT_CONTEXT_MAX_EVENTS=16
MODEL_TEMPERATURE=0.2
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_PAGE_SIZE=20

# Runtime observability
LOG_LEVEL=INFO
STRUCTURED_LOGGING=true
ENABLE_REQUEST_LOGGING=true
REQUEST_ID_HEADER=X-Request-ID

# Build and image retention
SKIP_EXISTING_IMAGES=true
ARTIFACT_KEEP_COUNT=3
ARTIFACT_RETENTION_DAYS=14

# Monitoring and logs
ENABLE_MONITORING=true
ENABLE_UPTIME_CHECK=false
UPTIME_CHECK_PERIOD=5
ENABLE_LOG_METRICS=true
EXCLUDE_HEALTH_CHECK_LOGS=true
MONITORING_ALIGNMENT_SECONDS=300
MONITORING_5XX_RATE_THRESHOLD=0
MONITORING_P95_LATENCY_MS=2000
MONITORING_ALLOYDB_CONNECTION_THRESHOLD=80

# Budget guardrails
BUDGET_AMOUNT=1000INR
BUDGET_NAME="Productivity Intelligence Platform Budget"
BUDGET_THRESHOLDS=0.25,0.50,0.75,0.90,1.00

# Lifecycle
AUTO_SUSPEND_AFTER_DEPLOY=false
ALLOYDB_STATE_TIMEOUT_SECONDS=900
ENABLE_SCHEDULED_LIFECYCLE=false
LIFECYCLE_RESUME_CRON="0 9 * * 1-5"
LIFECYCLE_SUSPEND_CRON="0 20 * * *"
LIFECYCLE_TIMEZONE=Asia/Kolkata
