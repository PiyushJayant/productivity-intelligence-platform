FROM python:3.11-slim

WORKDIR /app
COPY requirements-migrate.txt .
RUN pip install --no-cache-dir -r requirements-migrate.txt
COPY setup ./setup
COPY productivity_intelligence/__init__.py ./productivity_intelligence/__init__.py
COPY productivity_intelligence/tokenization.py ./productivity_intelligence/tokenization.py

WORKDIR /app
ENTRYPOINT ["python"]
CMD ["-m", "setup.migrate"]
